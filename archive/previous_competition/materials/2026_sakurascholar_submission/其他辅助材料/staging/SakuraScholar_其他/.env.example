# SakuraScholar 环境变量示例
# 复制为 .env 并填入实际值后即可使用真实 LLM / 真实检索后端。
# MVP 阶段不需要任何 key 即可跑通：默认使用 MockLLM + Mock 数据。

# =============== LLM 选型 ===============
# 可选: mock | openai | deepseek | qwen_api | glm | qwen
# - mock:       离线关键词匹配，零依赖（默认）
# - openai:     OpenAI 官方 API（gpt-4o-mini）
# - deepseek:   DeepSeek API（deepseek-chat，价格友好）
# - qwen_api:   通义千问 DashScope 兼容 API（qwen-plus）
# - glm:        智谱 GLM API（glm-4-flash，免费额度）
# - qwen:       本地 Qwen 模型（需 transformers + torch）
SAKURA_LLM_PROVIDER=mock
SAKURA_LLM_MODEL=mock-llm-v1

# 本地 Qwen 路径（启用 qwen provider 时填写）
SAKURA_QWEN_PATH=Qwen/Qwen2.5-7B-Instruct

# =============== OpenAI 兼容 API Keys ===============
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 通义千问 DashScope（https://dashscope.console.aliyun.com）
DASHSCOPE_API_KEY=

# 智谱 GLM（https://open.bigmodel.cn）
GLM_API_KEY=

# =============== 检索后端 ===============
# 每个后端最大召回数
SAKURA_PER_BACKEND_K=20

# Semantic Scholar API key（推荐：申请免费 key 可享 1 rps 专用额度）
# 申请：https://www.semanticscholar.org/product/api#api-key
# 不填则用匿名共享池（易 429，系统已自动退避+熔断降级到 arXiv/CrossRef/PubMed）
S2_API_KEY=

# OpenAlex polite pool（填邮箱可享更高限速，不填也能用）
OPENALEX_EMAIL=
# OpenAlex 免费 API key（openalex.org/settings/api，每日 $1 免费额度；余额耗尽时
# 系统默认不携带该 key，改用匿名 Polite Pool 通道，避免触发计费 429）
OPENALEX_API_KEY=
# 1 表示强制使用上面付费 key（默认 0：余额不足时自动绕过）
OPENALEX_USE_PAID_KEY=0

# =============== 日志 ===============
SAKURA_LOG_LEVEL=INFO
