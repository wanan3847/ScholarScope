background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 03 · 关键技术
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 关键技术 ①：查询规划（双输出 + 文档驱动）
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: in-box
    elementType: shape
    bounds: [56, 132, 300, 110]
    shapeName: rect
    fill: {type: solid, color: "#F7F2EA"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: in-label
    elementType: text
    bounds: [72, 142, 270, 24]
    content:
      style: "$caption"
      align: [left, middle]
      text: 用户输入（复杂自然语言查询）
  - elementId: in-text
    elementType: text
    bounds: [72, 172, 268, 60]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.5
      text: “图神经网络在药物相互作用预测中的最新进展”
  - elementId: a-in
    elementType: line
    bounds: [356, 180, 56, 28]
    viewBox: [1, 1]
    points: "0,0.5 1,0.5"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: qp-box
    elementType: shape
    bounds: [412, 132, 160, 110]
    shapeName: rect
    fill: {type: solid, color: "#EAD9C8"}
    border: {style: solid, width: 1, color: "$accent"}
  - elementId: qp-t
    elementType: text
    bounds: [412, 142, 160, 90]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      align: [center, middle]
      text: |
        <p>QueryPlanner</p>
        <p style="font-size:11px; font-weight:normal; color:#6B6361;">LLM 查询理解与改写</p>
  - elementId: a-out
    elementType: line
    bounds: [572, 180, 56, 28]
    viewBox: [1, 1]
    points: "0,0.5 1,0.5"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: out-box
    elementType: shape
    bounds: [628, 132, 276, 110]
    shapeName: rect
    fill: {type: solid, color: "#F7F2EA"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: out-t
    elementType: text
    bounds: [644, 140, 248, 96]
    content:
      fontSize: 12.5
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.5
      text: |
        <p><strong>约 10 个关键词</strong>（AND 布尔检索）</p>
        <p><strong>8 条语义短语</strong>（语义召回）</p>
        <p><strong>标题风格查询</strong>（去疑问词/元词，降级补偿）</p>
  - elementId: note1
    elementType: text
    bounds: [56, 268, 848, 30]
    content:
      style: "$small"
      align: [left, middle]
      text: 解决“整句查询在词法引擎中召回极差”的问题；标题风格查询不读取评测 gold，适用于隐藏集
  - elementId: round2-box
    elementType: shape
    bounds: [56, 330, 848, 130]
    shapeName: rect
    fill: {type: solid, color: "#F3EADF"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: round2-t
    elementType: text
    bounds: [72, 340, 500, 30]
    content:
      fontSize: 15
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      align: [left, middle]
      text: 迭代 Round 2：文档驱动查询生成
  - elementId: round2-steps
    elementType: text
    bounds: [72, 378, 816, 70]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.55
      text: |
        <p>依据 top-5 高分论文的标题 / 摘要，1 次 LLM 调用生成 5 条新查询（“论文标题风格”短语）</p>
        <p>配合标题词补充，走 arXiv + OpenAlex + 本地通道 → 覆盖“词面零重叠”的语义型 gold</p>
  - elementId: footer
    elementType: text
    bounds: [56, 508, 300, 20]
    content:
      style: "$caption"
      align: [left, middle]
      text: SakuraScholar · 樱花学术
  - elementId: pageno
    elementType: text
    bounds: [880, 508, 40, 20]
    content:
      style: "$caption"
      align: [right, middle]
      text: 06 / 17
