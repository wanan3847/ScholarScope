    rows:
      - - text: "配置"
        - text: "样本"
        - text: "平均 LLM 调用/条"
        - text: "P50 延时"
        - text: "成本特征"
      - - text: "DeepSeek（三件套）"
        - text: "20"
        - text: "24.3"
        - text: "约 176s"
        - text: "低单价 API，总额可控"
      - - text: "DeepSeek（全通道校准）"
        - text: "20"
        - text: "54.2"
        - text: "约 176s"
        - text: "多轮迭代调用较多"
      - - text: "本地 Qwen3:8b（全量）"
        - text: "50"
        - text: "33.4"
        - text: "约 205s"
        - text: "本地推理零 API 费用"
