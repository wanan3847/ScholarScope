background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 04 · 实验与评测
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 效率、成本与容错
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: eff-table
    elementType: table
    bounds: [56, 128, 848, 150]
    columnWidths: [0.26, 0.12, 0.24, 0.16, 0.22]
    rowHeights: [0.34, 0.22, 0.22, 0.22]
