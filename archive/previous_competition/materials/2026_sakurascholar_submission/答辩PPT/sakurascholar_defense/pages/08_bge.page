background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 03 · 关键技术
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 关键技术 ③：BGE 语义预筛 + 保底机制
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: formula-box
    elementType: shape
    bounds: [56, 140, 848, 96]
    shapeName: rect
    fill: {type: solid, color: "#F3EADF"}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: formula
    elementType: text
    bounds: [56, 148, 848, 80]
    content:
      fontSize: 26
      fontFamily: "MiSans"
      color: "$text"
      align: [center, middle]
      text: |
        <p>预排分 = 0.70 × BGE 语义 + 0.20 × 词面 + 0.10 × 被引归一</p>
        <p style="font-size:14px; color:#6B6361;">本地 FastEmbed BGE-small 向量（零成本、无外部 API）</p>
  - elementId: rule1
    elementType: line
    bounds: [56, 268, 848, 2]
    viewBox: [424, 1]
