background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 03 · 关键技术
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
