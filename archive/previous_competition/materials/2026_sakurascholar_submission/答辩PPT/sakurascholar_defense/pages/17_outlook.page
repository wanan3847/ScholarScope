pageType: final
background:
  type: solid
  color: "$paper"
elements:
  - elementId: swatch
    elementType: image
    bounds: [0, 0, 340, 540]
    src: "media/cover_left.png"
    fit: {mode: cover}
  - elementId: flower
    elementType: image
    bounds: [52, 146, 128, 128]
    src: "media/sakura.png"
    fit: {mode: contain}
  - elementId: petal1
    elementType: image
    bounds: [252, 430, 56, 56]
    src: "media/sakura.png"
    fit: {mode: contain}
  - elementId: thanks
    elementType: text
    bounds: [40, 300, 260, 90]
    content:
      fontSize: 26
      fontFamily: "思源宋体"
      color: "#F7F2EA"
      bold: true
      align: [center, middle]
      text: |
        <p>感谢聆听</p>
        <p style="font-size:14px; color:#D9C7CF; font-weight:normal;">恳请各位专家批评指正</p>
  - elementId: sec-label
    elementType: text
    bounds: [400, 60, 504, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: NEXT STEPS
  - elementId: title
    elementType: text
    bounds: [400, 92, 504, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 展望与下一步
  - elementId: rule
    elementType: line
    bounds: [400, 144, 460, 2]
    viewBox: [230, 1]
    points: "0,0 230,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: n1-t
    elementType: text
    bounds: [400, 168, 460, 44]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      align: [left, middle]
      text: 完成 AutoScholarQuery / LitQA2 / paper_finder 全量评测
  - elementId: n1-line
    elementType: line
    bounds: [400, 218, 460, 1]
    viewBox: [230, 1]
    points: "0,0 230,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: n2-t
    elementType: text
    bounds: [400, 230, 460, 44]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      align: [left, middle]
      text: 接入 S2 语义通道，补全本地语义索引至 100%
  - elementId: n2-line
    elementType: line
    bounds: [400, 280, 460, 1]
    viewBox: [230, 1]
    points: "0,0 230,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: n3-t
    elementType: text
    bounds: [400, 292, 460, 44]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      align: [left, middle]
      text: 引入 Selector 单 token 概率打分与端到端重排，压缩推理成本
  - elementId: n3-line
    elementType: line
    bounds: [400, 342, 460, 1]
    viewBox: [230, 1]
    points: "0,0 230,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: n4-t
    elementType: text
    bounds: [400, 354, 460, 44]
    content:
      fontSize: 14
      fontFamily: "MiSans"
      color: "$text"
      align: [left, middle]
      text: 基于反馈闭环做个性化排序，支持 Docker 一键部署
  - elementId: n4-line
    elementType: line
    bounds: [400, 404, 460, 1]
    viewBox: [230, 1]
    points: "0,0 230,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: contact
    elementType: text
    bounds: [400, 452, 504, 60]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$secondary"
      align: [left, middle]
      text: |
        <p>团队名称：樱花　项目：樱花学术（SakuraScholar）</p>
        <p>2026 年 8 月 24 日 · 中国研究生创新实践系列大赛</p>
