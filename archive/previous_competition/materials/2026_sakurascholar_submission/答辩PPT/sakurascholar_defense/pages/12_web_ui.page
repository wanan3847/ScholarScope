background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 02 · 方案落地
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: Web 界面实拍（真实系统截图）
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: img-home
    elementType: image
    bounds: [56, 128, 420, 263]
    src: "media/home.png"
    fit: {mode: cover}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: cap-home
    elementType: text
    bounds: [56, 396, 420, 24]
    content:
      style: "$caption"
      align: [center, middle]
      text: 图 1　首页 · 项目介绍（🌸 温暖学术风格）
  - elementId: img-result
    elementType: image
    bounds: [484, 128, 420, 263]
    src: "media/search_result.png"
    fit: {mode: cover}
    border: {style: solid, width: 1, color: "$line"}
  - elementId: cap-result
    elementType: text
    bounds: [484, 396, 420, 24]
    content:
      style: "$caption"
      align: [center, middle]
      text: 图 2　真实检索结果（20 篇论文 + 三件套）
  - elementId: note
    elementType: text
    bounds: [56, 440, 848, 40]
    content:
      style: "$small"
      align: [left, middle]
      text: 完整功能：搜索 · 收藏夹/文件夹 · BibTeX/RIS/CSV/JSON 导入导出 · 已阅 · 账号体系 · LLM 与 API 配置 · 管理员可编辑帮助文档
  - elementId: footer
    elementType: text
    bounds: [56, 508, 300, 20]
    content:
      style: "$caption"
      align: [left, middle]
      text: SakuraScholar · 樱花学术
  - elementId: pageno
    elementType: text
    bounds: [880, 508, 40, 20]
    content:
      style: "$caption"
      align: [right, middle]
      text: 12 / 17
