pageType: cover
background:
  type: solid
  color: "$paper"
elements:
  - elementId: swatch
    elementType: image
    bounds: [0, 0, 340, 540]
    src: "media/cover_left.png"
    fit: {mode: cover}
  - elementId: swatch-accent
    elementType: shape
    bounds: [0, 500, 340, 40]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: flower
    elementType: image
    bounds: [52, 166, 132, 132]
    src: "media/sakura.png"
    fit: {mode: contain}
  - elementId: petal1
    elementType: image
    bounds: [238, 84, 44, 44]
    src: "media/sakura.png"
    fit: {mode: contain}
  - elementId: petal2
    elementType: image
    bounds: [252, 424, 56, 56]
    src: "media/sakura.png"
    fit: {mode: contain}
  - elementId: brand-cn
    elementType: text
    bounds: [40, 330, 260, 40]
    content:
      fontSize: 22
      fontFamily: "思源宋体"
      color: "#F7F2EA"
      align: [left, middle]
      text: 樱花学术
  - elementId: brand-en
    elementType: text
    bounds: [40, 370, 260, 30]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "#D9C7CF"
      letterSpacing: 2
      align: [left, middle]
      text: SAKURASCHOLAR
  - elementId: brand-rule
    elementType: line
    bounds: [40, 406, 120, 2]
    viewBox: [60, 1]
    points: "0,0 60,0"
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: meta-top
    elementType: text
    bounds: [400, 96, 504, 28]
    content:
      style: "$small"
      align: [right, middle]
      letterSpacing: 1
      text: 中国研究生创新实践系列大赛 · 初赛参赛作品
  - elementId: rule
    elementType: line
    bounds: [400, 138, 420, 2]
    viewBox: [210, 1]
    points: "0,0 210,0"
    border: {style: solid, width: 2, color: "$accent"}
  - elementId: title-en
    elementType: text
    bounds: [400, 168, 520, 72]
    content:
      fontSize: 54
      fontFamily: "思源宋体"
      color: "$text"
      bold: true
      align: [left, middle]
      text: SakuraScholar
  - elementId: title-cn
    elementType: text
    bounds: [400, 244, 520, 76]
    content:
      fontSize: 21
      fontFamily: "思源宋体"
      color: "$text"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>科研场景下复杂学术查询的</p>
        <p>智能论文搜索与推荐系统</p>
  - elementId: meta-team
    elementType: text
    bounds: [400, 396, 504, 30]
    content:
      fontSize: 15
      fontFamily: "MiSans"
      color: "$secondary"
      align: [left, middle]
      text: 团队名称：樱花 · 项目文档 v1.0
  - elementId: meta-date
    elementType: text
    bounds: [400, 432, 504, 26]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$secondary"
      align: [left, middle]
      text: 2026 年 8 月 24 日 · 初赛提交截止 2026-09-01
  - elementId: footer-note
    elementType: text
    bounds: [400, 500, 504, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$secondary"
      align: [left, middle]
      text: 核心创意与主要开发过程均在大赛期间独立完成
