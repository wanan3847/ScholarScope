background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 03 · 关键技术
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 关键技术 ②：五通道并行检索
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: c1-name
    elementType: text
    bounds: [56, 134, 200, 44]
    content:
      fontSize: 16
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      align: [left, middle]
      text: arXiv API
  - elementId: c1-role
    elementType: text
    bounds: [280, 134, 400, 44]
    content:
      style: "$small"
      align: [left, middle]
      text: 计算机 / 交叉学科预印本，布尔检索
  - elementId: c1-fail
    elementType: text
    bounds: [700, 134, 204, 44]
    content:
      fontSize: 12
      fontFamily: "MiSans"
      color: "$secondary"
      align: [right, middle]
      text: 10s 超时 + 重试 + 熔断
  - elementId: c1-line
    elementType: line
