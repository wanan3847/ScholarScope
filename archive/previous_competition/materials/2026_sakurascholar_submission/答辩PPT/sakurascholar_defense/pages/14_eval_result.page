background:
  type: solid
  color: "$paper"
elements:
  - elementId: sec-label
    elementType: text
    bounds: [56, 26, 300, 22]
    content:
      fontSize: 11
      fontFamily: "MiSans"
      color: "$accent"
      letterSpacing: 3
      align: [left, middle]
      text: 04 · 实验与评测
  - elementId: title
    elementType: text
    bounds: [56, 52, 848, 46]
    content:
      style: "$title"
      align: [left, middle]
      text: 评测：RealScholarQuery 结果演进（F1@10）
  - elementId: rule
    elementType: line
    bounds: [56, 104, 848, 2]
    viewBox: [424, 1]
    points: "0,0 424,0"
    border: {style: solid, width: 1, color: "$line"}
  - elementId: chart
    elementType: chart
    bounds: [56, 128, 560, 300]
    data:
      cols: [版本, F1@10]
      rows:
        - [旧自研基线, 0.0171]
        - [SPAR2 早期, 0.0579]
        - [全通道校准, 0.0833]
        - [三件套版本, 0.1055]
    series:
      - type: bar
        encode: {x: 版本, y: F1@10}
        fill: "$accent"
        dataLabels: {show: true, content: value, numberFormat: "0.000", color: "#26211F", fontSize: 12}
    xAxis: {label: {fontSize: 11}, axisLine: {color: "#C9BFA9"}}
    yAxis: {min: 0, max: 0.13, label: {numberFormat: "0.00", fontSize: 11}, gridLine: {color: "#E7E0D2"}}
    legend: false
  - elementId: chart-note
    elementType: text
    bounds: [56, 436, 560, 30]
    content:
      style: "$caption"
      align: [center, middle]
      text: RealScholarQuery · DeepSeek 20 条 · 2026-08-22（数据见项目文档 7.3 节）
  - elementId: right-title
    elementType: text
    bounds: [640, 128, 264, 30]
    content:
      fontSize: 15
      fontFamily: "MiSans"
      color: "$text"
      bold: true
      align: [left, middle]
      text: 关键读数
  - elementId: r1-t
    elementType: text
    bounds: [640, 168, 264, 60]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.5
      text: |
        <p><strong>F1@10：0.0171 → 0.1055</strong></p>
        <p>三件套版本较全通道 +27%</p>
  - elementId: r2-t
    elementType: text
    bounds: [640, 240, 264, 60]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.5
      text: |
        <p><strong>Recall@20：0.1354（+29%）</strong></p>
        <p>本地 Qwen3:8b 全量 50 条 F1@10=0.0893，零失败</p>
  - elementId: r3-t
    elementType: text
    bounds: [640, 312, 264, 84]
    content:
      fontSize: 13
      fontFamily: "MiSans"
      color: "$text"
      align: [left, top]
      lineHeight: 1.5
      text: |
        <p><strong>诚实声明</strong>：当前仍低于 PaSa-7B 参考线</p>
        <p>（Recall@20=0.733），受限于 S2 长期 429 与候选</p>
        <p>召回规模，处于持续迭代中。</p>
  - elementId: footer
    elementType: text
    bounds: [56, 508, 300, 20]
    content:
      style: "$caption"
      align: [left, middle]
      text: SakuraScholar · 樱花学术
  - elementId: pageno
    elementType: text
    bounds: [880, 508, 40, 20]
    content:
      style: "$caption"
      align: [right, middle]
      text: 14 / 17
